# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Every variable the app reads is listed here. Ones marked (optional) have a
# working in-code default and can be left unset.

# --- Google / Gmail OAuth (required for the Gmail features) -------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com → APIs & Services → Credentials.
# Add the redirect URI below to the client's "Authorised redirect URIs".
# While the consent screen is in Testing mode, each developer's Google account
# must also be added under "Test users" or the flow fails at consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NOTE: the in-code default for this is port 3000, but the app runs on 3001.
# Leaving it unset causes redirect_uri_mismatch. Set it explicitly.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# --- Groq (cloud LLM) ---------------------------------------------------------
# https://console.groq.com → API Keys. Without this the app falls back to Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant          # (optional)

# --- Ollama (local LLM) -------------------------------------------------------
OLLAMA_URL=http://localhost:11434        # (optional)
OLLAMA_MODEL=llama3.1:8b                 # (optional)

# --- Kokoro (local text-to-speech sidecar) ------------------------------------
KOKORO_URL=http://127.0.0.1:7532         # (optional)
KOKORO_VOICE=af_bella                    # (optional)

# --- bCourses / Canvas --------------------------------------------------------
# The access token is NOT set here — it is entered in the UI (Setup →
# Connect bCourses) and stored in .data/canvas-token.json, which is gitignored.
CANVAS_BASE_URL=https://bcourses.berkeley.edu   # (optional)

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001       # (optional)
