# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Every variable the app reads is listed here. Ones marked (optional) have a
# working in-code default and can be left unset.

# --- Google / Gmail OAuth (required for the Gmail features) -------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com → APIs & Services → Credentials.
# Add the redirect URI below to the client's "Authorised redirect URIs".
# While the consent screen is in Testing mode, each developer's Google account
# must also be added under "Test users" or the flow fails at consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NOTE: the in-code default for this is port 3000, but the app runs on 3001.
# Leaving it unset causes redirect_uri_mismatch. Set it explicitly.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Workspace Google Calendar import (read-only). Enable Calendar API + add this redirect URI
# in the same OAuth client as above.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/integrations/google-calendar/callback

# --- Groq (entity extraction + cloud LLM) -------------------------------------
# https://console.groq.com → API Keys. Required for Task 10 entity extraction.
# Without GROQ_API_KEY, voice/legacy paths fall back to Ollama when configured.
GROQ_API_KEY=
# Optional override — must appear in your account's /v1/models list (see npm run groq:models).
# If unset, entity extraction picks the first available: openai/gpt-oss-20b → gpt-oss-120b → qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-20b

# --- Ollama (local LLM) -------------------------------------------------------
OLLAMA_URL=http://localhost:11434        # (optional)
OLLAMA_MODEL=llama3.1:8b                 # (optional)

# --- Kokoro (local text-to-speech sidecar) ------------------------------------
KOKORO_URL=http://127.0.0.1:7532         # (optional)
KOKORO_VOICE=af_bella                    # (optional)

# --- bCourses / Canvas --------------------------------------------------------
# The access token is NOT set here — it is entered in the UI (Setup →
# Connect bCourses) and stored in .data/canvas-token.json, which is gitignored.
CANVAS_BASE_URL=https://bcourses.berkeley.edu   # (optional)

# --- Supabase -----------------------------------------------------------------
# Project URL: https://<project-ref>.supabase.co (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# anon public JWT (Dashboard → Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer publishable key (sb_publishable_…); not a substitute for anon or service role
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — required for apply/undo (pg), integration tests, cron. Never expose to the browser.
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI for transactional apply/undo — NOT the https project URL above.
# Dashboard → Connect → Database → Connection string → URI (use "Session" or direct, not pooler if transactions fail)
SUPABASE_DB_URL=

# Stripe (Task 18 billing — test mode keys from dashboard.stripe.com)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for recurring plans (create Products/Prices in Stripe, 14-day trial configured in checkout)
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
# Used in Checkout success/cancel URLs and Customer Portal return URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
# IANA timezone for item due/start display (server + browser must match; default UTC)
# NEXT_PUBLIC_DISPLAY_TIME_ZONE=America/Los_Angeles

# Cron routes (adaptation retention jobs)
CRON_SECRET=

# Vitest RLS integration (usually local Supabase after `supabase start`)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_KEY=
# Direct Postgres URL for adaptation apply/undo transactions (Dashboard → Database → URI)
SUPABASE_TEST_DB_URL=
SUPABASE_DB_URL=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001       # (optional, legacy — merged shell uses Supabase)
# Set to true in local dev ONLY to re-enable filesystem /api/spaces (UI #1 lab). Never in production.
LEGACY_FILESYSTEM_API=
